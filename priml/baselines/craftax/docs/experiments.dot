digraph craftax {
  rankdir=LR;
  graph [fontname="Helvetica", nodesep=0.12, ranksep=0.35, margin=0.1, labelloc=t, fontsize=22,
         label="Craftax experiments: how each run builds on the last"];
  node  [shape=box, style="rounded,filled", fillcolor="white", fontname="Helvetica", fontsize=11];
  edge  [color="#888888"];

  subgraph cluster_main {
    label="Our recipe: the main line"; fontsize=14; style="rounded"; color="#2e7d32"; penwidth=2;
    exp000 [label="exp000\nPufferLib's published recipe\nscore 47%\nplayed 3.5B steps"];
    exp001 [label="exp001\nhigher-precision numbers\nscore 50%\nplayed 3.5B steps"];
    exp002 [label="exp002\nboard encoder, 20B steps\nscore 53%\nplayed 20B steps"];
    exp003 [label="exp003\npractice + self-imitation\nscore 72%\nplayed 20B steps", penwidth=2];
    exp004 [label="exp004\nextra boss training\nscore 80%, beats boss 43.5%\nplayed 3B more (23B total)", fillcolor="#b7e4b0", penwidth=3];
  }
  exp000 -> exp001 -> exp002 -> exp003 -> exp004 [color="#2e7d32", penwidth=3, weight=10];

  exp005 [label="exp005\nexp000, shorter training\nscore 15%\nplayed 250M steps", fillcolor="#f2f2f2"];
  exp008 [label="exp008\nexp003, new world every game\nscore 61% (stopped at 6B)\nplayed 6B steps", fillcolor="#f2f2f2"];
  exp006 [label="exp006\nexp002, 2x wider network\nscore 65%\nplayed 20B steps", fillcolor="#f2f2f2"];
  exp007 [label="exp007\nbetter board encoder\nscore 62%\nplayed 20B steps", fillcolor="#f2f2f2"];
  exp000 -> exp005;
  exp003 -> exp008;
  exp002 -> exp006 -> exp007;

  subgraph cluster_baselines {
    label="Published baselines, original game rules (context only)"; fontsize=14; style="rounded,dashed"; color="#999999"; fontcolor="#666666";
    node [fillcolor="#f2f2f2", fontcolor="#555555", color="#999999"];
    exp009 [label="exp009\nexp000 on original rules\nscore 12%\nplayed 3.5B steps"];
    exp010 [label="exp010\nCraftax paper's PPO\nscore 12%\nplayed 1B steps"];
    exp011 [label="exp011\nexp010, tiny budget\nscore 2%\nplayed 1M steps"];
    exp012 [label="exp012\n+ memory (GRU)\nscore 17%\nplayed 1B steps"];
    exp013 [label="exp013\nQ-learning instead\nscore 16%\nplayed 1B steps"];
    exp014 [label="exp014\nexp010, 100M budget\nscore 10%\nplayed 100M steps"];
    exp015 [label="exp015\n+ memory (Transformer)\nscore 17%\nplayed 1B steps"];
  }
  exp000 -> exp009 [color="#bbbbbb"];
  exp009 -> exp010 [color="#bbbbbb"];
  exp010 -> exp011 [color="#bbbbbb"]; exp010 -> exp012 [color="#bbbbbb"]; exp010 -> exp013 [color="#bbbbbb"];
  exp010 -> exp014 [color="#bbbbbb"]; exp010 -> exp015 [color="#bbbbbb"];

  subgraph cluster_world_model {
    label="World-model experiments (experimental, not yet officially published)"; fontsize=14; style="rounded,dashed"; color="#1f5fa8"; penwidth=2;
    node [fillcolor="#cfe0f7"];

    subgraph cluster_wm_test {
      label="Does a world model help? Cheap 250M-step test"; fontsize=12; style="rounded"; color="#1f5fa8";
      wm000 [label="WM exp000\nexp007 at 250M (control)\nscore 12% (mean of 150-250M)\nplayed 250M steps", fillcolor="white"];
      wm001 [label="WM exp001\n+ trained world model\nscore 43% (mean of 150-250M)\npolicy played 250M steps\nWM watched 50M (frozen)\nteachers played 43.5B steps"];
      wm002 [label="WM exp002\n+ untrained world model\nscore 12% (mean of 150-250M)\npolicy played 250M steps\nWM watched 0\nteachers played 0"];
    }

    subgraph cluster_wm_best {
      label="World model on our best recipe (exp003)"; fontsize=12; style="rounded"; color="#1f5fa8";
      wm003 [label="WM exp003\nWM taught by exp003 @ 1B\nscore 55%\npolicy played 20B steps\nWM watched 100M (frozen)\nteachers played 1B steps"];
      wm004 [label="WM exp004\nWM taught by exp003 @ 20B\nscore 70% (training, at 15.5B)\npolicy played 15.5B steps\nWM watched 100M (frozen)\nteachers played 20B steps"];
      wm005 [label="WM exp005\nWM exp003, WM keeps learning\nscore 67% (training, at 3.25B)\npolicy played 3.25B steps\nWM watched 100M (keeps learning)\nteachers played 1B steps"];
      wm006 [label="WM exp006\nWM exp004, WM keeps learning\nscore 65% (training, at 3.25B)\npolicy played 3.25B steps\nWM watched 100M (keeps learning)\nteachers played 20B steps"];
      wm007 [label="WM exp007\nWM exp003 stopped at 1B\nscore 38%\npolicy played 1B steps\nWM watched 100M (frozen)\nteachers played 1B steps"];
      wm008 [label="WM exp008\nWM exp005 stopped at 1B\nscore 52%\npolicy played 1B steps\nWM watched 100M (keeps learning)\nteachers played 1B steps"];
    }
  }
  exp007 -> wm000;
  wm000 -> wm001 -> wm002 [color="#1f5fa8", penwidth=2];
  exp003 -> wm003;
  wm003 -> wm004; wm003 -> wm005; wm003 -> wm007;
  wm004 -> wm006; wm005 -> wm008;

  key [shape=plaintext, style="", label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="4" BGCOLOR="white">
      <TR><TD COLSPAN="2" ALIGN="LEFT"><B>How to read this</B></TD></TR>
      <TR><TD ALIGN="LEFT">arrow</TD><TD ALIGN="LEFT">child = parent + one change (line 2)</TD></TR>
      <TR><TD ALIGN="LEFT">score</TD><TD ALIGN="LEFT">% of 226 achievement points, ~10k test games</TD></TR>
      <TR><TD ALIGN="LEFT">beats boss</TD><TD ALIGN="LEFT">% of test games that defeat the final boss</TD></TR>
      <TR><TD ALIGN="LEFT">played N steps</TD><TD ALIGN="LEFT">game actions the agent took while training (B = billion)</TD></TR>
      <TR><TD ALIGN="LEFT">policy played</TD><TD ALIGN="LEFT">steps the acting agent trained for</TD></TR>
      <TR><TD ALIGN="LEFT">WM exp</TD><TD ALIGN="LEFT">an experiment of experiments_world_model.py;<BR ALIGN="LEFT"/>the others are experiments.py's</TD></TR>
      <TR><TD ALIGN="LEFT">WM watched</TD><TD ALIGN="LEFT">recorded steps the world model trained on first;<BR ALIGN="LEFT"/>frozen = stops learning after that</TD></TR>
      <TR><TD ALIGN="LEFT">teachers played</TD><TD ALIGN="LEFT">steps spent training the agents whose games were recorded</TD></TR>
      <TR><TD ALIGN="LEFT">stopped at N</TD><TD ALIGN="LEFT">run did not finish; score is from that point</TD></TR>
      <TR><TD ALIGN="LEFT">training, at N</TD><TD ALIGN="LEFT">run still training; score is its latest evaluation</TD></TR>
      <TR><TD ALIGN="LEFT">mean of 150-250M</TD><TD ALIGN="LEFT">mean of the evaluations at 150M, 200M and 250M steps</TD></TR>
      <TR><TD ALIGN="LEFT">world model</TD><TD ALIGN="LEFT">network that learned the game from<BR ALIGN="LEFT"/>recorded games of other agents ("teachers")</TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#b7e4b0">green</TD><TD ALIGN="LEFT">best run</TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#cfe0f7">blue</TD><TD ALIGN="LEFT">uses a world model (experimental)</TD></TR>
      <TR><TD ALIGN="LEFT" BGCOLOR="#f2f2f2">gray</TD><TD ALIGN="LEFT">side experiment or outside baseline</TD></TR>
    </TABLE>>];
  exp008 -> key [style=invis];
}
