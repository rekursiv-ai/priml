    ) -> tuple[tuple[Array, Array], Array]: ...
    @nowrap
    def initialize_carry(
        self,
        rng: PRNGKey,
        input_shape: tuple[int, ...],
    ) -> tuple[Array, Array]: ...
    @property
    def num_feature_axes(self) -> int: ...

