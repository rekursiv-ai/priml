from collections.abc import Iterator, Sequence
from typing import Generic
from typing_extensions import TypeVar

class dtype: ...

class pointer_type(dtype):
    element_ty: dtype

bfloat16: dtype
float16: dtype
float32: dtype
int32: dtype
int64: dtype
uint8: dtype

_DType = TypeVar("_DType", bound=dtype, default=dtype, covariant=True)

class tensor(Generic[_DType]):
    def to(self, dtype: dtype) -> tensor: ...
    def __index__(self) -> int: ...
    def __getitem__(self, index: object) -> tensor: ...
    def __add__(self, other: _Scalar) -> tensor: ...
    def __radd__(self, other: _Scalar) -> tensor: ...
    def __sub__(self, other: _Scalar) -> tensor: ...
    def __rsub__(self, other: _Scalar) -> tensor: ...
    def __mul__(self, other: _Scalar) -> tensor: ...
    def __rmul__(self, other: _Scalar) -> tensor: ...
    def __truediv__(self, other: _Scalar) -> tensor: ...
    def __rtruediv__(self, other: _Scalar) -> tensor: ...
    def __floordiv__(self, other: _Scalar) -> tensor: ...
    def __rfloordiv__(self, other: _Scalar) -> tensor: ...
    def __mod__(self, other: _Scalar) -> tensor: ...
    def __rmod__(self, other: _Scalar) -> tensor: ...
    def __neg__(self) -> tensor: ...
    def __invert__(self) -> tensor: ...
    def __and__(self, other: _Scalar) -> tensor: ...
    def __rand__(self, other: _Scalar) -> tensor: ...
    def __or__(self, other: _Scalar) -> tensor: ...
    def __ror__(self, other: _Scalar) -> tensor: ...
    def __lt__(self, other: _Scalar) -> tensor: ...
    def __le__(self, other: _Scalar) -> tensor: ...
    def __gt__(self, other: _Scalar) -> tensor: ...
    def __ge__(self, other: _Scalar) -> tensor: ...
    def __eq__(self, other: _Scalar) -> tensor: ...  # pyright: ignore[reportIncompatibleMethodOverride] -- Triton tensors compare elementwise, not to bool.
    def __ne__(self, other: _Scalar) -> tensor: ...  # pyright: ignore[reportIncompatibleMethodOverride] -- Triton tensors compare elementwise, not to bool.
    @property
    def dtype(self) -> _DType: ...

type _Scalar = tensor | int | float | bool
type constexpr = int

def debug_barrier() -> tensor: ...
def program_id(axis: int) -> tensor: ...
def arange(start: int, end: int) -> tensor: ...
def zeros(shape: Sequence[int], dtype: dtype) -> tensor: ...
def full(shape: Sequence[int], value: _Scalar, dtype: dtype) -> tensor: ...
def load(
    pointer: tensor,
    mask: tensor | None = ...,
    other: _Scalar = ...,
    boundary_check: tuple[int, ...] = ...,
    padding_option: str = ...,
) -> tensor: ...
def store(
    pointer: tensor,
    value: _Scalar,
    mask: tensor | None = ...,
    boundary_check: tuple[int, ...] = ...,
) -> None: ...
def make_block_ptr(
    base: tensor,
    shape: Sequence[int | tensor],
    strides: Sequence[int | tensor],
    offsets: Sequence[int | tensor],
    block_shape: Sequence[int],
    order: Sequence[int],
) -> tensor: ...
def advance(base: tensor, offsets: Sequence[int | tensor]) -> tensor: ...
def atomic_add(
    pointer: tensor,
    value: tensor,
    mask: tensor | None = ...,
    sem: str | None = ...,
) -> tensor: ...
def atomic_xchg(
    pointer: tensor,
    value: tensor,
    mask: tensor | None = ...,
) -> tensor: ...
def dot(a: tensor, b: tensor) -> tensor: ...
def trans(x: tensor) -> tensor: ...
def where(condition: tensor, x: _Scalar, y: _Scalar) -> tensor: ...
def maximum(x: _Scalar, y: _Scalar) -> tensor: ...
def minimum(x: _Scalar, y: _Scalar) -> tensor: ...
def max(x: tensor, axis: int | None = ...) -> tensor: ...
def argmax(x: tensor, axis: int | None = ...) -> tensor: ...
def sum(x: tensor, axis: int | None = ...) -> tensor: ...
def cumsum(x: tensor, axis: int = ..., reverse: bool = ...) -> tensor: ...
def exp(x: tensor) -> tensor: ...
def exp2(x: tensor) -> tensor: ...
def log(x: tensor) -> tensor: ...
def log2(x: tensor) -> tensor: ...
def rsqrt(x: tensor) -> tensor: ...
def sqrt(x: tensor) -> tensor: ...
def sqrt_rn(x: tensor) -> tensor: ...
def abs(x: _Scalar) -> tensor: ...
def fma(x: _Scalar, y: _Scalar, z: _Scalar) -> tensor: ...
def sigmoid(x: tensor) -> tensor: ...
def range(
    start: _Scalar,
    stop: _Scalar | None = ...,
    step: _Scalar = ...,
) -> Iterator[tensor]: ...
def static_assert(condition: object, message: str = ...) -> None: ...
def static_range(
    start: int,
    stop: int | None = ...,
    step: int = ...,
) -> Iterator[int]: ...
def broadcast_to(input: tensor, shape: Sequence[int]) -> tensor: ...
