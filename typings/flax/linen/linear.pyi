from collections.abc import Sequence
from typing import Any, Protocol

from _typeshed import Incomplete
from flax.core import meta as meta
from flax.linen import (
    initializers as initializers,
    module as module,
)
from flax.linen.dtypes import promote_dtype as promote_dtype
from flax.linen.module import (
    Module as Module,
    compact as compact,
)
from flax.typing import (
    Array as Array,
    ConvGeneralDilatedT as ConvGeneralDilatedT,
    DotGeneralT as DotGeneralT,
    Dtype as Dtype,
