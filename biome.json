{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,css}",
      "!**/third_party",
      "!**/vendor",
      "!**/*.min.js"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 88 },
  "linter": {
    "enabled": true,
    "rules": {
      "style": { "noDescendingSpecificity": "off" }
    }
  },
  "assist": { "enabled": false }
}
