import jax

A = TypeVar("A")
type Carry = Any
type CarryHistory = Any
type Output = Any

class RNNCellBase(Module):
    @nowrap
    def initialize_carry(self, rng: PRNGKey, input_shape: tuple[int, ...]) -> Carry: ...
    @property
    def num_feature_axes(self) -> int: ...

class LSTMCell(RNNCellBase):
    features: int
    gate_fn: Callable[..., Any] = ...
    activation_fn: Callable[..., Any] = ...
    kernel_init: Initializer = ...
    recurrent_kernel_init: Initializer = ...
    bias_init: Initializer = ...
    dtype: Dtype | None = ...
    param_dtype: Dtype = ...
    carry_init: Initializer = ...
    @compact
    def __call__(self, carry, inputs): ...
    @nowrap
    def initialize_carry(
        self,
        rng: PRNGKey,
        input_shape: tuple[int, ...],
    ) -> tuple[Array, Array]: ...
    @property
    def num_feature_axes(self) -> int: ...

class DenseParams(Module):
    features: int
    use_bias: bool = ...
    param_dtype: Dtype = ...
    precision: PrecisionLike = ...
    kernel_init: Initializer = ...
    bias_init: Initializer = ...
    @compact
    def __call__(self, inputs: Array) -> tuple[Array, Array | None]: ...

class OptimizedLSTMCell(RNNCellBase):
