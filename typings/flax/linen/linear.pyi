def canonicalize_padding(padding: PaddingLike, rank: int) -> LaxPadding: ...

class _Conv(Module):
    features: int
    kernel_size: int | Sequence[int]
    strides: int | Sequence[int] | None = ...
    padding: PaddingLike = ...
    input_dilation: int | Sequence[int] | None = ...
    kernel_dilation: int | Sequence[int] | None = ...
    feature_group_count: int = ...
    use_bias: bool = ...
    mask: Array | None = ...
    dtype: Dtype | None = ...
    param_dtype: Dtype = ...
    precision: PrecisionLike = ...
    kernel_init: Initializer = ...
    bias_init: Initializer = ...
    promote_dtype: PromoteDtypeFn = ...
    conv_general_dilated: ConvGeneralDilatedT | None = ...
    conv_general_dilated_cls: Any = ...
    @property
    def shared_weights(self) -> bool: ...
